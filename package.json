{
  "name": "pickup-playwright-tests",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:regression": "playwright test --grep \"@critical|@high\"",
    "test:coverage": "node scripts/clean-coverage.js && playwright test && c8 --all --include=server.js --reports-dir=coverage --reporter=text --reporter=json --reporter=lcov --check-coverage --lines=80 --functions=80 --branches=80 --statements=80 node --test coverage-tests/server.test.js",
    "test:ci": "npm run test:coverage",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.7.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "c8": "^12.0.0",
    "typescript": "^5.9.0"
  }
}
